# 복사해서 .env.local로 쓰세요. 실제 값(.env.local)은 Git에 올리지 않습니다.

# 로컬 백엔드 주소. 비워 두면 백엔드 없이 브라우저 목업(MockWorkspaceService)으로 돕니다.
# start.bat은 이 값을 http://127.0.0.1:8000 으로 넣고 백엔드도 함께 켭니다.
NEXT_PUBLIC_API_URL=

# --- 아래는 백엔드(webapp/server) 환경변수입니다. 브라우저에는 가지 않습니다. ---
# fake = 비용 없는 가짜 오케스트레이터(기본, webapp/.data/sandbox에만 씀)
# claude = 저장소 루트에서 실제 로이드 세션(claude -p)을 엽니다 — 모델 사용량이 발생합니다
# DOCUMASTER_ORCHESTRATOR=fake
# claude -p에 넘길 권한 모드(기본 auto — CLI에서 쓰는 방식과 같게)
# DOCUMASTER_CLAUDE_PERMISSION_MODE=auto
# API 키는 넣지 않습니다. claude·codex·nlm은 각 CLI에 로그인된 계정을 그대로 씁니다.

# Owner PIN의 해시(원문 PIN이 아님). 비워 두면 webapp/.data/owner.json(setup_owner.py가 씀)을 씁니다.
# 해시만 뽑으려면: server에서 .venv\Scripts\python setup_owner.py --print
DOCUMASTER_OWNER_PIN_HASH=
# HTTPS로 띄울 때만 1(로컬 http에서 1이면 브라우저가 로그인 쿠키를 버립니다)
# DOCUMASTER_COOKIE_SECURE=
# 화면 주소(로그인 쿠키를 받을 곳). 기본: http://localhost:3000,http://127.0.0.1:3000
# DOCUMASTER_CORS_ORIGINS=
